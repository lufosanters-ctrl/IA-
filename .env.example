# ---------------------------------------------------------------------------
# Núcleo — configuração
# Copie para .env e ajuste. Tudo é opcional: sem nenhuma variável a plataforma
# sobe em modo extrativo (busca real nas bases, sem reescrita por modelo).
# ---------------------------------------------------------------------------

# Ativa a síntese neural das respostas, flashcards e planos de estudo.
# Chave em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Modelo usado na síntese.
NUCLEO_MODELO=claude-sonnet-5

# Servidor
HOST=127.0.0.1
PORTA=8000
RECARREGAR=false

# Biblioteca de livros
#
# ATENÇÃO, WINDOWS: escreva o caminho SEM aspas duplas. Entre aspas, este
# arquivo interpreta sequências de escape, e o \n de uma pasta como \nome
# vira uma quebra de linha — o caminho chega partido e o servidor não sobe.
#
#   certo:  DIRETORIO_BIBLIOTECA=C:\Users\seu-nome\livros
#   certo:  DIRETORIO_BIBLIOTECA=C:/Users/seu-nome/livros
#   ERRADO: DIRETORIO_BIBLIOTECA="C:\Users\seu-nome\livros"
#
# O padrão abaixo é a pasta biblioteca/ dentro do projeto, e serve na maioria
# dos casos.
DIRETORIO_BIBLIOTECA=./biblioteca
MAX_MB_POR_LIVRO=200

# Pesquisa
MAX_RESULTADOS_POR_FONTE=6
MAX_TRECHOS_CONTEXTO=14
TIMEOUT_HTTP=20
